{
  "openapi": "3.1.0",
  "info": {
    "title": "GridOps Fleet and Operations API",
    "version": "1.0.0",
    "description": "Machine-readable contract for `/api/v1/fleet` and `/api/v1/operations`.\n\nBrowser routes authenticate with the dashboard session cookie or, where marked, a scoped API token (`Authorization: Bearer gat_...`). A request carrying both a cookie and a bearer token is refused. Agent routes are the host-agent protocol and use a host credential, never an API token.\n\nSee docs/fleet-api.md for the human contract and docs/fleet-automation.md for bot-driven enrollment."
  },
  "servers": [{ "url": "/" }],
  "tags": [
    { "name": "fleet-read", "description": "Read fleet state (token scope `fleet:read` or cookie)" },
    { "name": "fleet-enroll", "description": "Issue and manage enrollment codes (token scope `fleet:enroll` or cookie)" },
    { "name": "fleet-approve", "description": "Approve pending hosts (token scope `fleet:approve` or cookie)" },
    { "name": "fleet-operate", "description": "Run-time levers: runtimes, lifecycle, grants, pool profiles, deleting retired machines (token scope `fleet:operate` or cookie)" },
    { "name": "fleet-admin", "description": "Cookie-only administration (API tokens, recovery, retirement, rotation)" },
    { "name": "operations", "description": "Durable operation status (token scope `fleet:read` or cookie)" },
    { "name": "agent-protocol", "description": "Host-agent protocol; bearer host credential, not an API token" }
  ],
  "security": [{ "cookieAuth": [] }],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Scoped API token: `gat_` followed by 43 base64url characters. Created by an administrator; scopes are fleet:read, fleet:enroll, fleet:approve, fleet:operate."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "gridops_session",
        "description": "Dashboard session cookie from GitHub OAuth sign-in."
      },
      "hostCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "A 43-character host credential issued at enrollment. Never valid on browser routes."
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Replaying a key with the same body returns the original result; a different body is an idempotency_conflict.",
        "schema": { "type": "string", "minLength": 8, "maxLength": 128 }
      },
      "HostId": {
        "name": "host_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Uuid" }
      },
      "BackendId": {
        "name": "backend_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Uuid" }
      },
      "TargetId": {
        "name": "target_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Uuid" }
      },
      "PoolId": {
        "name": "pool_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Uuid" }
      },
      "EnrollmentId": {
        "name": "enrollment_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Uuid" }
      },
      "TokenId": {
        "name": "token_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Uuid" }
      },
      "OperationId": {
        "name": "operation_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Uuid" }
      }
    },
    "schemas": {
      "Uuid": { "type": "string", "format": "uuid" },
      "Cursor": { "type": ["string", "null"], "maxLength": 4096 },
      "ErrorDetails": {
        "oneOf": [
          {
            "type": "object",
            "properties": { "kind": { "const": "revision" }, "currentRevision": { "type": "integer", "minimum": 1 } },
            "required": ["kind", "currentRevision"], "additionalProperties": false
          },
          {
            "type": "object",
            "properties": { "kind": { "const": "invalid_field" }, "field": { "type": "string" } },
            "required": ["kind", "field"], "additionalProperties": false
          },
          {
            "type": "object",
            "properties": { "kind": { "const": "limit" }, "maximum": { "type": "integer", "minimum": 0 } },
            "required": ["kind", "maximum"], "additionalProperties": false
          },
          {
            "type": "object",
            "properties": { "kind": { "const": "retry" }, "retryAfterMs": { "type": "integer", "minimum": 0 } },
            "required": ["kind", "retryAfterMs"], "additionalProperties": false
          },
          { "type": "object", "properties": { "kind": { "const": "cursor_gap" } }, "required": ["kind"], "additionalProperties": false },
          {
            "type": "object",
            "properties": { "kind": { "const": "readiness" }, "reason": { "type": "string" } },
            "required": ["kind", "reason"], "additionalProperties": false
          },
          {
            "type": "object",
            "properties": { "kind": { "const": "scope" }, "requiredScope": { "type": "string", "enum": ["fleet:read", "fleet:enroll", "fleet:approve", "fleet:operate"] } },
            "required": ["kind", "requiredScope"], "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": { "const": "delete_blocked" },
              "reasons": { "type": "array", "items": { "$ref": "#/components/schemas/HostDeleteBlocker" } }
            },
            "required": ["kind", "reasons"], "additionalProperties": false
          }
        ]
      },
      "HostDeleteBlocker": {
        "type": "string",
        "description": "Why a machine cannot be deleted yet. A refusal lists every reason that applies.",
        "enum": ["not_retired", "still_heartbeating", "active_credential", "live_placement", "unconfirmed_start", "live_runner", "pending_command"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": ["invalid_request", "unauthenticated", "forbidden", "not_found", "revision_conflict", "idempotency_conflict", "enrollment_expired", "grant_expired", "cursor_expired", "cursor_gap", "payload_too_large", "rate_limited", "dependency_unavailable", "not_ready", "contract_range", "host_not_deletable"]
          },
          "message": { "type": "string" },
          "requestId": { "$ref": "#/components/schemas/Uuid" },
          "details": { "oneOf": [{ "$ref": "#/components/schemas/ErrorDetails" }, { "type": "null" }] }
        },
        "required": ["code", "message", "requestId"],
        "additionalProperties": false
      },
      "HostSummary": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/components/schemas/Uuid" },
          "name": { "type": "string" },
          "hostOs": { "type": "string", "enum": ["linux", "macos", "windows"] },
          "architecture": { "type": "string", "enum": ["x64", "arm64"] },
          "enrollment": { "type": "string", "enum": ["pending", "approved", "revoked"] },
          "lifecycle": { "type": "string", "enum": ["active", "paused", "draining", "maintenance", "retired"] },
          "integrity": { "type": "string" },
          "freshness": { "type": "string" },
          "pressure": { "type": "string" },
          "revision": { "type": "integer", "minimum": 1 },
          "agentVersion": { "type": ["string", "null"] },
          "lastHeartbeatAt": { "type": ["string", "null"], "format": "date-time" },
          "backendCount": { "type": "integer", "minimum": 0 },
          "runnerCount": { "type": "integer", "minimum": 0 }
        },
        "required": ["id", "name", "hostOs", "architecture", "enrollment", "lifecycle", "integrity", "freshness", "pressure", "revision", "backendCount", "runnerCount"],
        "additionalProperties": false
      },
      "PlacementFailureGroup": {
        "type": "object",
        "description": "Placements on one host that failed for the same reason in the last 24 hours.",
        "properties": {
          "reason": {
            "type": "string",
            "description": "Why the placement failed. Derived from facts the server had when it failed; `unknown` when no cause was available or the code is not recognised.",
            "enum": ["agent_reported", "agent_outcome_unknown", "prepare_deadline_expired", "start_deadline_expired", "agent_session_lost", "host_epoch_changed", "runner_removed_before_start", "operator_released", "unknown"]
          },
          "message": { "type": "string", "maxLength": 240, "description": "The newest failure's message." },
          "count": { "type": "integer", "minimum": 1 },
          "latestAt": { "type": "string", "format": "date-time" },
          "latestPlacementId": { "$ref": "#/components/schemas/Uuid" }
        },
        "required": ["reason", "message", "count", "latestAt", "latestPlacementId"],
        "additionalProperties": false
      },
      "HostPage": {
        "type": "object",
        "properties": {
          "schemaVersion": { "type": "integer", "const": 1 },
          "readAt": { "type": "string", "format": "date-time" },
          "items": { "type": "array", "maxItems": 100, "items": { "$ref": "#/components/schemas/HostSummary" } },
          "nextCursor": { "$ref": "#/components/schemas/Cursor" }
        },
        "required": ["schemaVersion", "readAt", "items", "nextCursor"],
        "additionalProperties": false
      },
      "EnrollmentIssueRequest": {
        "type": "object",
        "properties": {
          "targetIds": { "type": "array", "maxItems": 64, "items": { "$ref": "#/components/schemas/Uuid" } },
          "intendedHostId": { "type": ["string", "null"] },
          "lifetimeMinutes": { "type": "integer", "minimum": 1, "maximum": 60 }
        },
        "required": ["targetIds"],
        "additionalProperties": false
      },
      "EnrollmentIssueCreated": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "minLength": 43, "maxLength": 43, "description": "The one-time enrollment code; shown exactly once." },
          "enrollmentId": { "$ref": "#/components/schemas/Uuid" },
          "expiresAt": { "type": "string", "format": "date-time" }
        },
        "required": ["code", "enrollmentId", "expiresAt"],
        "additionalProperties": false
      },
      "EnrollmentStatus": {
        "type": "object",
        "properties": {
          "enrollmentId": { "$ref": "#/components/schemas/Uuid" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "consumedAt": { "type": ["string", "null"], "format": "date-time" },
          "revokedAt": { "type": ["string", "null"], "format": "date-time" },
          "consumedHostId": { "type": ["string", "null"], "description": "Correlates the code with its host; poll until set." }
        },
        "required": ["enrollmentId", "expiresAt"],
        "additionalProperties": false
      },
      "ApproveRequest": {
        "type": "object",
        "properties": {
          "expectedRevision": { "type": "integer", "minimum": 1 },
          "expectedInventoryRevision": { "type": "integer", "minimum": 1 },
          "expectedInventoryDigest": { "type": "string" },
          "targetIds": { "type": "array", "maxItems": 64, "items": { "$ref": "#/components/schemas/Uuid" } }
        },
        "required": ["expectedRevision", "expectedInventoryRevision", "expectedInventoryDigest", "targetIds"],
        "additionalProperties": false
      },
      "LifecycleRequest": {
        "type": "object",
        "properties": {
          "lifecycle": { "type": "string", "enum": ["active", "paused", "draining", "maintenance"] },
          "expectedRevision": { "type": "integer", "minimum": 1 }
        },
        "required": ["lifecycle", "expectedRevision"],
        "additionalProperties": false
      },
      "BackendEnabledRequest": {
        "type": "object",
        "properties": { "enabled": { "type": "boolean" } },
        "required": ["enabled"],
        "additionalProperties": false
      },
      "BudgetRequest": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "cpuMillis": { "type": "integer", "minimum": 1, "description": "CPU in thousandths of a core, at most what the machine reports." },
          "memoryMib": { "type": "integer", "minimum": 1, "description": "Memory in MiB, at most what the machine reports." },
          "diskBytes": { "type": "integer", "minimum": 1, "description": "Disk in bytes, at most what the machine reports." }
        },
        "additionalProperties": false
      },
      "BudgetResponse": {
        "type": "object",
        "properties": {
          "budget": {
            "type": "object",
            "properties": {
              "cpuMillis": { "type": "integer", "minimum": 0 },
              "memoryMib": { "type": "integer", "minimum": 0 },
              "diskBytes": { "type": "integer", "minimum": 0 }
            },
            "required": ["cpuMillis", "memoryMib", "diskBytes"]
          }
        },
        "required": ["budget"]
      },
      "GrantRequest": {
        "type": "object",
        "properties": {
          "allowSchedule": { "type": "boolean" },
          "allowNative": { "type": "boolean" },
          "allowDockerSocket": { "type": "boolean", "description": "Hands jobs root-equivalent host access through the Docker socket; deliberate opt-in." }
        },
        "required": ["allowSchedule", "allowNative", "allowDockerSocket"],
        "additionalProperties": false
      },
      "OperationStatus": {
        "type": "object",
        "properties": {
          "schemaVersion": { "type": "integer", "const": 1 },
          "operationId": { "$ref": "#/components/schemas/Uuid" },
          "state": { "type": "string", "enum": ["queued", "running", "succeeded", "failed", "cancelled", "blocked"] }
        },
        "required": ["schemaVersion", "operationId", "state"],
        "additionalProperties": true
      }
    },
    "examples": {
      "fleetErrorRevisionConflict": {
        "value": {
          "code": "revision_conflict",
          "message": "The host changed since it was read.",
          "requestId": "0192f0c4-7a1e-7c3b-9f00-3d1c2b4a5e6f",
          "details": { "kind": "revision", "currentRevision": 7 }
        }
      },
      "fleetErrorScopeDenied": {
        "value": {
          "code": "forbidden",
          "message": "Fleet action is not authorized",
          "requestId": "0192f0c4-7a1e-7c3b-9f00-3d1c2b4a5e70",
          "details": { "kind": "scope", "requiredScope": "fleet:approve" }
        }
      },
      "fleetErrorHostNotDeletable": {
        "value": {
          "code": "host_not_deletable",
          "message": "Machine cannot be deleted yet",
          "requestId": "0192f0c4-7a1e-7c3b-9f00-3d1c2b4a5e71",
          "details": { "kind": "delete_blocked", "reasons": ["live_placement", "pending_command"] }
        }
      },
      "enrollmentIssueCreated": {
        "value": {
          "code": "7MFBNUWH2DWCLSPZR4XZJRMNFBWKMPRLIQZKBEXYKV4",
          "enrollmentId": "0192f0c4-7a1e-7c3b-9f00-3d1c2b4a5e80",
          "expiresAt": "2026-10-31T23:00:00.000Z"
        }
      }
    },
    "responses": {
      "ErrorResponse": {
        "description": "Fleet error envelope; see the code table in docs/fleet-api.md.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "examples": {
              "revisionConflict": { "$ref": "#/components/examples/fleetErrorRevisionConflict" },
              "scopeDenied": { "$ref": "#/components/examples/fleetErrorScopeDenied" }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/fleet/hosts": {
      "get": {
        "tags": ["fleet-read"],
        "summary": "Paginated host list",
        "security": [{ "bearerAuth": ["fleet:read"] }, { "cookieAuth": [] }],
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } },
          { "name": "cursor", "in": "query", "schema": { "$ref": "#/components/schemas/Cursor" } }
        ],
        "responses": {
          "200": {
            "description": "Host page",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HostPage" } } }
          },
          "default": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/api/v1/fleet/hosts/{host_id}": {
      "get": {
        "tags": ["fleet-read"],
        "summary": "One host with approval evidence",
        "security": [{ "bearerAuth": ["fleet:read"] }, { "cookieAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/HostId" }],
        "responses": {
          "200": { "description": "Host detail (projection `host`). The `host` projection also carries `failedPlacementsLastHour` (integer) and `recentPlacementFailures`, the last 24 hours of recorded placement failures grouped by reason, newest group first (see `PlacementFailureGroup`).", "content": { "application/json": { "schema": { "type": "object", "properties": { "item": { "type": "object", "properties": { "failedPlacementsLastHour": { "type": "integer", "minimum": 0 }, "recentPlacementFailures": { "type": "array", "maxItems": 10, "items": { "$ref": "#/components/schemas/PlacementFailureGroup" } }, "duplicateHardwareOf": { "type": "array", "maxItems": 5, "description": "Other approved, unretired machines reporting the same hardware that the reader may see, so the stale record is easy to tell from the live one.", "items": { "type": "object", "properties": { "id": { "$ref": "#/components/schemas/Uuid" }, "name": { "type": "string" } }, "required": ["id", "name"], "additionalProperties": false } } } } } } } } },
          "default": { "$ref": "#/components/responses/ErrorResponse" }
        }
      },
      "delete": {
        "tags": ["fleet-operate"],
        "summary": "Delete a retired machine",
        "description": "Permanently removes a machine that can never take work again from the machine list, the counts and capacity. Allowed for a retired machine, or one that never finished enrolling (not approved) and has not reported in for 90 seconds. Refused with `409 host_not_deletable` while the machine is approved but not retired, still reporting in, holds an unrevoked credential (approved machines), or still has a placement that is not cleaned up, an unconfirmed start, capacity still charged, a runner that has not finished, or a command waiting within its deadline; `details.reasons` names every reason that applies. The delete is soft: placements, events, samples and audit history stay, and the machine's credential, open recovery codes and grants are revoked. An agent still using the machine's credential is rejected as `unauthenticated` and cannot recreate it. Enrolling the computer again creates a new record. The audit row `fleet.host.deleted` names the actor (and the API token name when one was used), the machine's name and id, and its last heartbeat. Deleting a machine that is already deleted is `404 not_found`.",
        "security": [{ "bearerAuth": ["fleet:operate"] }, { "cookieAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/HostId" }],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "hostId": { "$ref": "#/components/schemas/Uuid" } }, "required": ["hostId"], "additionalProperties": false } } }
          },
          "409": {
            "description": "The machine cannot be deleted yet; `details.kind` is `delete_blocked`.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" }, "examples": { "hostNotDeletable": { "$ref": "#/components/examples/fleetErrorHostNotDeletable" } } } }
          },
          "default": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/api/v1/fleet/hosts/{host_id}/backends": {
      "get": {
        "tags": ["fleet-read"],
        "summary": "Execution backends of a host",
        "security": [{ "bearerAuth": ["fleet:read"] }, { "cookieAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/HostId" }],
        "responses": {
          "200": { "description": "Backend page", "content": { "application/json": { "schema": { "type": "object" } } } },
          "default": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/api/v1/fleet/hosts/{host_id}/backends/{backend_id}": {
      "get": {
        "tags": ["fleet-read"],
        "summary": "One execution backend",
        "security": [{ "bearerAuth": ["fleet:read"] }, { "cookieAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/HostId" }, { "$ref": "#/components/parameters/BackendId" }],
        "responses": {
          "200": { "description": "Backend detail", "content": { "application/json": { "schema": { "type": "object" } } } },
          "default": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/api/v1/fleet/hosts/{host_id}/domains": {
      "get": {
        "tags": ["fleet-read"],
        "summary": "Resource domains (physical access only)",
        "security": [{ "bearerAuth": ["fleet:read"] }, { "cookieAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/HostId" }],
        "responses": {
          "200": { "description": "Domain page", "content": { "application/json": { "schema": { "type": "object" } } } },
          "default": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/api/v1/fleet/hosts/{host_id}/domains/{domain_id}": {
      "get": {
        "tags": ["fleet-read"],
        "summary": "One resource domain (physical access only)",
        "security": [{ "bearerAuth": ["fleet:read"] }, { "cookieAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/HostId" }, { "name": "domain_id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Uuid" } }],
        "responses": {
          "200": { "description": "Domain detail", "content": { "application/json": { "schema": { "type": "object" } } } },
          "default": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/api/v1/fleet/hosts/{host_id}/samples": {
      "get": {
        "tags": ["fleet-read"],
        "summary": "Resource samples (physical access only)",
        "security": [{ "bearerAuth": ["fleet:read"] }, { "cookieAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/HostId" }],
        "responses": {
          "200": { "description": "Sample page", "content": { "application/json": { "schema": { "type": "object" } } } },
          "default": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/api/v1/fleet/hosts/{host_id}/events": {
      "get": {
        "tags": ["fleet-read"],
        "summary": "Host event history",
        "security": [{ "bearerAuth": ["fleet:read"] }, { "cookieAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/HostId" }],
        "responses": {
          "200": { "description": "Event page. A placement that failed has an event of kind `placement_failed`; its cause is on the host detail's `recentPlacementFailures`.", "content": { "application/json": { "schema": { "type": "object" } } } },
          "default": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/api/v1/fleet/hosts/{host_id}/grants": {
      "get": {
        "tags": ["fleet-read"],
        "summary": "Target grants of a host",
        "security": [{ "bearerAuth": ["fleet:read"] }, { "cookieAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/HostId" }],
        "responses": {
          "200": { "description": "Grant list", "content": { "application/json": { "schema": { "type": "object" } } } },
          "default": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/api/v1/fleet/hosts/{host_id}/unconfirmed": {
      "get": {
        "tags": ["fleet-read"],
        "summary": "Unconfirmed host observations",
        "security": [{ "bearerAuth": ["fleet:read"] }, { "cookieAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/HostId" }],
        "responses": {
          "200": { "description": "Unconfirmed observations", "content": { "application/json": { "schema": { "type": "object" } } } },
          "default": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/api/v1/fleet/targets": {
      "get": {
        "tags": ["fleet-read"],
        "summary": "CI targets",
        "security": [{ "bearerAuth": ["fleet:read"] }, { "cookieAuth": [] }],
        "responses": {
          "200": { "description": "Target list", "content": { "application/json": { "schema": { "type": "object" } } } },
          "default": { "$ref": "#/components/responses/ErrorResponse" }
        }
      }
    },
    "/api/v1/fleet/workload": {
      "get": {
        "tags": ["fleet-read"],
        "summary": "Workload overview",
        "security": [{ "bearerAuth": ["fleet:read"] }, { "cookieAuth": [] }],
